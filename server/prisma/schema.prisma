datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  name     String?
  events   Event[]
  contacts Contact[]
}

model Event {
  id           String   @id @default(cuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  isMeeting    Boolean  @default(false)
  
  location     String?
  meetingType  String?
  participants String?
  notes        String?
  
  reminderSet  Boolean  @default(false)
  reminderTime DateTime?
  
  createdAt    DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}